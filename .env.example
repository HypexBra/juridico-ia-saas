# ─── Supabase (banco + auth + storage) ─────────────────────
# Crie um projeto gratuito em https://supabase.com e rode a migration
# em supabase/migrations/0001_init.sql no SQL Editor do projeto.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque_a_anon_key_aqui

# ─── Pool de chaves de IA (Gemini/Groq) ─────────────────────
# A partir da migration 0032, as chaves de API dos provedores de LLM
# (Gemini/Groq) usadas pela plataforma vivem na tabela `ia_provider_chaves`
# (cadastradas via /admin/ia-chaves), não mais em env vars fixas — isso
# permite N chaves por provedor com rotação/rate-limit por chave, sem
# redeploy. Gere um valor aleatório de alta entropia 1x por ambiente para
# esta chave e NUNCA o troque depois que houver chaves salvas (perderia
# acesso às chaves de provedor já cifradas no banco). Segrega blast radius:
# nunca reusa WHATSAPP_TOKEN_ENCRYPTION_KEY.
IA_PROVIDER_KEY_ENCRYPTION_KEY=gere_um_valor_aleatorio_longo

# ─── Google Gemini / Groq (SOMENTE TRANSIÇÃO) ───────────────
# GEMINI_API_KEY/GROQ_API_KEY abaixo só são lidas por lib/ia/gemini.ts e
# lib/ia/groq.ts como FALLBACK, quando não existe NENHUMA linha ativa para
# aquele provider em `ia_provider_chaves` — é uma ponte para ambientes que
# ainda não migraram para o pool via /admin/ia-chaves, NÃO a arquitetura
# permanente. Cadastre a chave real como a primeira linha do provider em
# /admin/ia-chaves assim que possível e pode deixar estas duas em branco.
# Gere uma chave grátis do Gemini em https://aistudio.google.com/apikey
GEMINI_API_KEY=coloque_a_chave_aqui
GROQ_API_KEY=coloque_a_chave_aqui

# ─── URL pública da aplicação ───────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Cron jobs (Vercel Cron) ────────────────────────────────
# Secret compartilhado que o Vercel Cron envia em
# `Authorization: Bearer ${CRON_SECRET}` — protege os endpoints em
# app/api/cron/* contra chamadas externas não autorizadas.
CRON_SECRET=gere_um_valor_aleatorio_longo

# ─── WhatsApp (Meta Cloud API) — lembretes de prazo/parcela ─
# Chave usada só pelo servidor (AES-256-GCM) para criptografar o
# `token_acesso` de cada escritório antes de gravar em
# `canais_whatsapp_escritorio` (ver lib/whatsapp/criptografia.ts). Gere um
# valor aleatório de alta entropia 1x por ambiente e nunca o troque depois
# que houver canais salvos (perderia acesso aos tokens já criptografados).
WHATSAPP_TOKEN_ENCRYPTION_KEY=gere_um_valor_aleatorio_longo

# Nomes dos templates aprovados no WhatsApp Manager da Meta para esta conta
# (opcional — só necessário se os templates não usarem os nomes padrão).
WHATSAPP_TEMPLATE_PRAZO=lembrete_prazo
WHATSAPP_TEMPLATE_PARCELA=lembrete_parcela_honorario

# ─── Stripe (billing do plano Pro) ──────────────────────────
# Ainda SEM conta Stripe real — deixe tudo abaixo em branco/vazio. Sem
# STRIPE_SECRET_KEY, `app/api/billing/checkout` responde 501 e sem
# STRIPE_WEBHOOK_SECRET, `app/api/webhooks/stripe` rejeita 100% dos payloads
# com 401 (estruturalmente pronto, mas inerte). Quando a conta existir:
#   1. Chave secreta em https://dashboard.stripe.com/apikeys
#   2. Crie 1 Product "Plano Pro" com 1 Price recorrente mensal e cole o
#      price_id (formato price_xxx) em STRIPE_PRICE_ID_PRO_MENSAL
#   3. Configure o endpoint de webhook (`/api/webhooks/stripe`) escutando
#      checkout.session.completed, customer.subscription.updated e
#      customer.subscription.deleted; cole o "Signing secret" em
#      STRIPE_WEBHOOK_SECRET
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_MENSAL=
